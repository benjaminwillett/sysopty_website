# Sysopty website: Caddy terminates HTTPS (automatic certificates) and compresses responses;
# everything is proxied to waitress so the application sets every security header itself.
sysopty.com {
	encode zstd gzip
	# Caddy sends X-Forwarded-For/-Proto/-Host by default; waitress must trust them (see the unit file).
	reverse_proxy 127.0.0.1:8080
	header -Server
	log {
		output file /var/log/caddy/sysopty-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}

www.sysopty.com {
	redir https://sysopty.com{uri} permanent
}
