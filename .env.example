# Sysopty website configuration. Set these as environment variables (or in the service
# manager's environment); never commit a filled-in copy. wsgi.py refuses to start if the
# configuration is unsafe and logs which setting is wrong (never its value).

# REQUIRED. Signs the anti-spam form token. A random value of at least 32 characters,
# identical for every worker/process, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SYSOPTY_FORM_SECRET=

# Enquiry delivery by SMTP. Until SYSOPTY_SMTP_HOST, SYSOPTY_MAIL_FROM and SYSOPTY_MAIL_TO are
# set, the enquiry endpoint answers 503 and the page tells visitors their message was not sent.
SYSOPTY_SMTP_HOST=
SYSOPTY_SMTP_PORT=587
SYSOPTY_SMTP_SECURITY=starttls        # starttls (port 587) | ssl (port 465) | none (relay without login only)
SYSOPTY_SMTP_USERNAME=                # leave empty for an unauthenticated internal relay
SYSOPTY_SMTP_PASSWORD=                # required when a username is set; refused with SMTP_SECURITY=none
SYSOPTY_MAIL_FROM=                    # an address the SMTP service may send as, e.g. website@<your domain>
SYSOPTY_MAIL_TO=                      # the inbox that receives enquiries

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For/-Proto/-Host (Caddy, nginx, IIS ARR).
# Without it, every visitor appears to come from the proxy and shares one rate limit.
SYSOPTY_TRUST_PROXY=0

# Strict-Transport-Security max-age in seconds, sent on HTTPS responses only. 0 disables it.
SYSOPTY_HSTS_MAX_AGE=31536000
